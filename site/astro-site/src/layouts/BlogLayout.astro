  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} — Theatrum</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700;800&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap"
    rel="stylesheet"
  />
<!-- Microsoft Ads UET (tag 187278315) + consentimento -->
<script is:inline>
  /* Microsoft Ads UET, tag 187278315.
     1) Consentimento primeiro: anúncio negado até a pessoa aceitar no
        aviso de cookies (js/consentimento.js). Quem já aceitou numa
        visita anterior recebe o 'update' aqui mesmo, antes do UET.
     2) O snippet oficial da Microsoft, sem alteração, só que disparado
        no primeiro gesto ou quando a página fica ociosa, como o GTM da
        home: script de medição rodando no carregamento travava a página.
        Nada se perde: até o bat.js chegar, window.uetq é uma fila, e o
        UET a lê inteira quando sobe. */
  window.uetq = window.uetq || [];
  window.uetq.push('consent', 'default', {'ad_storage': 'denied'});
  try { if (localStorage.getItem('theatrum-cookies') === 'aceito') window.uetq.push('consent', 'update', {'ad_storage': 'granted'}); } catch (e) {}
  (function () {
    var subiu = false;
    function uet() {
      if (subiu) return; subiu = true;
      (function(w,d,t,r,u){var f,n,i;w[u]=w[u]||[],f=function(){var o={ti:"187278315", enableAutoSpaFix: true};o.q=w[u],w[u]=new UET(o),w[u].push("pageLoad")},n=d.createElement(t),n.src=r,n.async=1,n.onload=n.onreadystatechange=function(){var s=this.readyState;s&&s!=="loaded"&&s!=="complete"||(f(),n.onload=n.onreadystatechange=null)},i=d.getElementsByTagName(t)[0],i.parentNode.insertBefore(n,i)})(window,document,"script","https://bat.bing.com/bat.js","uetq");
    }
    ["pointerdown", "touchstart", "keydown", "scroll"].forEach(function (ev) {
      addEventListener(ev, uet, { once: true, passive: true });
    });
    addEventListener("load", function () {
      if (window.requestIdleCallback) requestIdleCallback(uet, { timeout: 6000 });
      else setTimeout(uet, 3000);
    });
  })();
</script>
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-N247ZTJ5"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <header class="site-header">
    <a href="/" class="brand">Theatrum</a>
    <a href="/blog/" class="back-link">← Blog</a>
  </header>
  <main>
    <slot />
  </main>
  <footer class="site-footer">
    <p>Theatrum — identidade digital pra negócios locais. · <a href="/privacidade/">Privacidade</a></p>
  </footer>
<script is:inline src="/js/consentimento.js" defer></script>
<script is:inline src="/js/uet-eventos.js" defer></script>
<script is:inline src="/js/leads.js" defer></script>
</body>
</html>

<style is:global>
  :root {
    --bg: #0b0a08;
    --bg-2: #100e0b;
    --card: #1a1815;
    --accent: #e3b341;
    --accent-soft: #f0d488;
    --accent2: #8e1f2f;
    --cream: #f6f1e7;
    --white: #ffffff;
    --muted: #a39b8d;
    --ink: #141210;
    --line: rgba(255, 255, 255, 0.1);
    --font-display: "Space Grotesk", sans-serif;
    --font-body: "Inter", sans-serif;
    --font-mono: "JetBrains Mono", monospace;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--bg);
    color: var(--white);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 24px 6vw;
    border-bottom: 1px solid var(--line);
  }

  .site-header .brand {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 19px;
    text-decoration: none;
    color: var(--white);
  }

  .site-header .back-link {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.3s;
  }

  .site-header .back-link:hover {
    color: var(--accent);
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 60px 6vw 100px;
  }

  .site-footer {
    text-align: center;
    padding: 30px 6vw 50px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--muted);
  }
</style>
