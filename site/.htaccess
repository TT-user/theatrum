# Pasta de trabalho, não página do site. O repositório é publicado
# inteiro pela Hostinger; sem esta regra o arquivo ficaria aberto no
# domínio (rascunho de artigo, script de build, documentação interna e o
# blog antigo em Astro, aposentado em 13/10/2026).
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
