# credenciais — o repositório é público, nada de token aqui
.env
.env.*

# mídia gerada — pesada demais para o repo, reproduzível pelos scripts
img/
video/
overlay/
fonts/

# os finais de Instagram ficam versionados porque a API da Meta baixa o
# arquivo de uma URL pública: são servidos pelo raw do GitHub na hora de
# postar. Vale para o vídeo do Reel e para o jpg do post estático.
final/*
!final/instagram/
final/instagram/*
!final/instagram/*.mp4
!final/instagram/*.jpg

# prints de referencia de estilo, so para eu olhar
referencia/
