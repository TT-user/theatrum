# Acervo com senha. Até 09/11/2026 guardava todos os sites; desde então a lista mora em
# /projetos/, aberta para quem tem o link, e as prévias de negócio real abertas em
# projetos/<tipo>-<cidade>/. Aqui ficam só as prévias que esperam autorização (antes e depois,
# depoimentos e avaliações com nome de cliente), listadas no fechados.json, que a /projetos/
# lê quando o navegador tem a chave. O index.html daqui leva para /projetos/.
#
# Só abre com o cookie theatrum_acervo, que o entrar.html grava depois da senha.
# Sem ele, qualquer endereço desta pasta (página, imagens, fechados.json) devolve o entrar.html.
# As prévias têm .htaccess com RewriteEngine próprio, que anula esta regra nelas:
# por isso cada uma repete a condição do cookie.
# O valor é o SHA-256 de "theatrum-acervo:" + senha. Trocou a senha, troque o
# valor aqui e nas prévias (procure por theatrum_acervo).
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  # nada daqui fica no CDN da Hostinger: senão a página aberta por quem tem a
  # chave poderia ser servida a quem não tem
  Header always set Cache-Control "private, no-store"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)theatrum_acervo=9a41d2e1276d2343473ecd807d9db0b8dbb222f4ec7353f470c4beafd1a6d703(;|$)
  RewriteRule !^entrar\.html$ /acervo/entrar.html [L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
