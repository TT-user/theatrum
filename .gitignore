MazyOS/

# Astro blog source — build output goes to /blog (tracked, is what Hostinger serves)
site/astro-site/node_modules/
site/astro-site/dist/
site/astro-site/.astro/

# ferramentas locais de agente (nao fazem parte do site)
.agents/
.mcp.json
skills-lock.json

# chaves de API. Este repositorio e publicado como site: um .env
# commitado aqui fica servido em texto puro no dominio.
.env
*.env
!.env.exemplo

# oficina das fotos dos demos: PNG de origem e dependencias do
# conversor. O que o site consome sao os JPG dentro de cada demo/img.
**/demos/_fotos/png-*/
**/demos/_fotos/contato-*.jpg
**/demos/_fotos/conferencia.jpg
**/demos/_fotos/node_modules/
**/demos/_fotos/package*.json

# mesma oficina, para a demo de loja, que fica fora de uma pasta demos/.
# As reprovadas ficam so no disco: sao o registro do que nao passou na
# conferencia, nao asset do site.
**/_fotos/node_modules/
**/_fotos/package*.json
**/_fotos/reprovadas/
# vídeo cru saido do gerador: pesa alguns MB e o que o site serve é a
# versão comprimida dentro da demo
**/_fotos/*.mp4
