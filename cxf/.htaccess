# Prévia da loja da CXF, gerada por cxf-loja/scripts/previa.mjs. Não edite aqui: rode o script de novo.
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# DESATIVADA em 28/10/2026: quem abre o link vai para a home da Theatrum; só quem entrou no
# /acervo/ (cookie com a chave da senha) continua vendo. Para reativar, apague este bloco.
# Trocou a senha do acervo, troque o valor aqui também (no theatrum, procure por theatrum_acervo).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)theatrum_acervo=9a41d2e1276d2343473ecd807d9db0b8dbb222f4ec7353f470c4beafd1a6d703(;|$)
  RewriteRule ^ https://usetheatrum.com.br/ [R=302,L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>

# URLs sem .html, como no Firebase Hosting (cleanUrls). /kits e a pasta kits/ convivem: sem o
# DirectorySlash Off, o Apache mandaria /cxf/kits para /cxf/kits/ (pasta sem índice).
DirectorySlash Off
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>
ErrorDocument 404 /cxf/404.html

# CSS, JS e fontes têm hash no nome: cache longo. HTML e JSON sempre do servidor.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
