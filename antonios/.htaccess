# A prévia saiu daqui em 29/10/2026 (de 29/10 a 09/11/2026 ficou no acervo, com senha) e,
# desde 09/11/2026, mora em /projetos/imobiliaria-rio-de-janeiro/, aberta para quem tem o link. Este é o
# endereço que foi mandado ao cliente: continua levando todo mundo para a home.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^ https://usetheatrum.com.br/ [R=302,L]
</IfModule>
<IfModule !mod_rewrite.c>
  Require all denied
</IfModule>
